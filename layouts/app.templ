package layouts

templ AppLayout(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<link rel="stylesheet" href="/static/css/app.css"/>
			<script src="/static/js/app.js" defer></script>
		</head>
		<body>
			<main>
				{ children... }
			</main>
		</body>
	</html>
}
