{
  "name": "loop",
  "version": "1.0.0",
  "description": "",
  "homepage": "https://github.com/karledenstal/loop#readme",
  "bugs": {
    "url": "https://github.com/karledenstal/loop/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karledenstal/loop.git"
  },
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "dev:css": "sass assets/scss/app.scss static/css/app.css --watch",
    "dev:js": "esbuild assets/js/app.js --bundle --outfile=static/js/app.js --watch",
    "dev:reload": "browser-sync start --proxy localhost:4282 --files 'static/css/*.css, static/js/*.js, tmp/main' --no-open --no-ui",
    "dev:go": "air",
    "dev": "concurrently --kill-others --names css,js,reload,go \"bun run dev:css\" \"bun run dev:js\" \"bun run dev:reload\" \"bun run dev:go\""
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.0",
    "sass": "^1.99.0"
  },
  "dependencies": {
    "alpinejs": "^3.15.12",
    "browser-sync": "^3.0.4",
    "dayjs": "^1.11.20",
    "htmx.org": "^2.0.10"
  }
}
